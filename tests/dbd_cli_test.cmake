execute_process(COMMAND "${TOOL}" dbd-status RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
if(NOT result STREQUAL "3")
  message(FATAL_ERROR "Expected explicit unavailable exit 3; got ${result}: ${error}")
endif()
string(JSON scope GET "${output}" scope)
string(JSON connected GET "${output}" connected)
string(JSON adapter GET "${output}" adapter_implemented)
string(JSON validated GET "${output}" live_session_validated)
string(JSON version GET "${output}" target_version)
if(connected OR adapter OR validated OR NOT scope STREQUAL "binary_capabilities" OR NOT version STREQUAL "10.2.2")
  message(FATAL_ERROR "CLI incorrectly claimed a game connection: ${output}")
endif()
message(STATUS "Explicit NOT CONNECTED and expected exit 3 verified")
